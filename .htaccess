# ==========================================================
# YoursSpeciallyJewellery - Apache & LiteSpeed Configuration
# Optimized for Hostinger Web Hosting & Premium Security
# ==========================================================

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent direct access to critical configuration and include files
    RewriteRule ^config/ - [F,L,NC]
    RewriteRule ^includes/ - [F,L,NC]
    RewriteRule ^database\.sql$ - [F,L,NC]
    RewriteRule ^\.env$ - [F,L,NC]
    RewriteRule ^README.*\.md$ - [F,L,NC]
</IfModule>

# 2. Block Direct Execution of Scripts in Uploads Folder (Exploit Defense)
<Directory "assets/uploads">
    <FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|htm|shtml|sh|cgi)$">
        Order Deny,Allow
        Deny from all
    </FilesMatch>
</Directory>

# 3. Security HTTP Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Disable Directory Browsing
Options -Indexes

# 5. Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 6. Default Charset
AddDefaultCharset UTF-8
